<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- DATE -->
    <TextView
        android:id="@+id/date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/today_date_placeholder"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/date_top_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- FORM -->
    <LinearLayout
        android:id="@+id/start_form"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/form_padding_horizontal"
        android:paddingEnd="@dimen/form_padding_horizontal"
        android:paddingTop="@dimen/form_padding_vertical"
        android:paddingBottom="@dimen/form_padding_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_form_action"
        app:layout_constraintTop_toBottomOf="@id/date_text"
        android:layout_marginTop="@dimen/form_top_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/form_side_margin"
        android:layout_marginEnd="@dimen/form_side_margin">

        <ImageView
            android:id="@+id/start_icon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_marginEnd="@dimen/text_margin_left"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/start_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inizia_allenamento"
            android:textSize="@dimen/text_size"
            android:textColor="@color/black"/>

        <ImageView
            android:id="@+id/start_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/down_arrow"
            android:contentDescription="@string/desc_down_arrow"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="@dimen/form_arrow_margin"/>
    </LinearLayout>

    <!-- VIEW-CARD HINT (visible only when a saved scheda is selected) -->
    <TextView
        android:id="@+id/tv_view_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="clicca per visualizzare la scheda"
        android:textStyle="italic"
        android:textColor="@color/gray"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/start_form"
        android:layout_marginTop="@dimen/text_margin_small"
        app:layout_constraintStart_toStartOf="@id/start_form"
        app:layout_constraintEnd_toEndOf="@id/start_form"/>

    <!-- TIMER -->
    <TextView
        android:id="@+id/timer_text"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:gravity="center"
        android:text="0:00:00"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:background="@drawable/bg_timer_circle"
        app:layout_constraintTop_toBottomOf="@id/tv_view_card"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BUTTONS SET 1 -->
    <LinearLayout
        android:id="@+id/timer_buttons_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/timer_text"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="@dimen/form_side_margin"
        android:paddingEnd="@dimen/form_side_margin">

        <Button
            android:id="@+id/btn_avvia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="@string/avvia"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_green"
            android:backgroundTint="@null" />

        <LinearLayout
            android:id="@+id/set_running_locked"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pausa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/pausa"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:enabled="false"
                android:background="@drawable/bg_button_yellow"
                android:backgroundTint="@null"/>

            <ImageButton
                android:id="@+id/btn_lock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:scaleType="centerInside"
                android:src="@drawable/lucchetto"
                android:background="@drawable/bg_lock_rect"
                android:backgroundTint="@color/light_gray"
                android:contentDescription="@string/lock_desc"
                android:adjustViewBounds="true"/>

            <Button
                android:id="@+id/btn_fine_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/fine"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:enabled="false"
                android:background="@drawable/bg_button_red"
                android:backgroundTint="@null"/>

        </LinearLayout>

        <!-- BUTTONS SET 2 -->
        <LinearLayout
            android:id="@+id/set_paused"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_riprendi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/riprendi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_green"
                android:backgroundTint="@null"/>

            <ImageButton
                android:id="@+id/btn_unlock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:scaleType="centerInside"
                android:src="@drawable/lucchetto_aperto"
                android:background="@drawable/bg_lock_rect"
                android:backgroundTint="@color/light_gray"
                android:contentDescription="@string/unlock_desc"
                android:adjustViewBounds="true"/>

            <Button
                android:id="@+id/btn_fine_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/fine"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:enabled="false"
                android:background="@drawable/bg_button_red"
                android:backgroundTint="@null"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/timer_buttons_container"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"/>

    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_nav_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
